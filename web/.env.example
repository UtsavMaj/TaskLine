# Base URL of the API, WITHOUT the trailing /api.
# Leave empty when the API is reachable on the same origin under /api
# (Vite dev proxy locally, vercel.json rewrite or Nginx in production).
# Set it when the web app calls the API on another domain directly, e.g. https://taskline-api.onrender.com
# (then the API needs COOKIE_SAMESITE=none and this site in CORS_ORIGINS).
VITE_API_URL=
