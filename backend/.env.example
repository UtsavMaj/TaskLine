# ---------------------------------------------------------------
# Taskline API - copy to .env and adjust. Every variable is
# validated at startup (src/config/env.ts).
# ---------------------------------------------------------------

NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgresql://taskline:taskline@localhost:5432/taskline?schema=public

# Secret used to sign access tokens (HS256). At least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Access token lifetime in minutes, refresh token (session) lifetime in days
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Browser origins allowed by CORS (comma separated, no trailing slash)
CORS_ORIGINS=http://localhost:5173

# Refresh-token cookie for the web app.
#   lax  -> web and API on the same site (local dev with the Vite proxy, or a rewrite/proxy in production)
#   none -> web and API on different domains (forces Secure=true, needs HTTPS)
COOKIE_SAMESITE=lax
# COOKIE_SECURE=true   # defaults to true in production

# Number of reverse proxies in front of the API (Render/Railway/Nginx = 1). Used for client IPs.
TRUST_PROXY=0

# bcrypt cost factor
BCRYPT_ROUNDS=12

# Login brute-force protection: max failed attempts per IP per window
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
# General limit for all API routes, requests per minute per IP
API_RATE_LIMIT_MAX=300

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
